{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "desktop",
  "sourceRoot": "apps/desktop/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/desktop"],
      "options": {
        "command": "node tools/scripts/build-desktop.mjs"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/serve-desktop.mjs"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p {projectRoot}/tsconfig.json --noEmit"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "playwright test -c apps/desktop/playwright.config.ts"
      }
    }
  }
}
